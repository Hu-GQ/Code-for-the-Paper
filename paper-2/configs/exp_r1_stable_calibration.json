{
  "experiment_id": "exp_r1_stable_calibration",
  "entry_function": "exp_r1_stable_calibration",
  "title": "Major revision R1: pure Poisson conditional stable calibration",
  "model": "model_mwspm_gen3_rhohat",
  "model_version": "gen3_rhohat",
  "solver": {
    "solver": "rk4",
    "dt": 0.025
  },
  "mu_variant": "day",
  "fixed_rho": 0.8,
  "phase_penalty": false,
  "objective": "pure Poisson negative log likelihood; no argmax peak penalty",
  "free": [
    "m0",
    "onset_doy",
    "offset_doy",
    "mu_s",
    "gamma",
    "beta"
  ],
  "box_source": "mwspm_calib_theta('box'); rho fixed for historical comparison only",
  "optimiser": {
    "n_screen": 0,
    "n_seed": 0,
    "restarts": 0,
    "seed": 13,
    "maxFunEvals": 2500,
    "maxIter": 2500,
    "TolX": 1e-05,
    "TolFun": 1e-07,
    "verbose": true
  },
  "deterministic": true,
  "outputs": [
    "verification.json",
    "stable_fit.json",
    "fit_trace.csv",
    "summary.json"
  ]
}
